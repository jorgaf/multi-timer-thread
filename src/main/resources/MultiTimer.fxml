<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ec.edu.utpl.carreras.computacion.controller.MultiTimerController"
      spacing="10" alignment="CENTER" stylesheets="@styles.css">

    <!-- Repetir este HBox para cada temporizador o generarlo dinámicamente -->
    <HBox fx:id="timerContainer" spacing="10" />

    <Button fx:id="startButton"
            text="Iniciar todos"
            onAction="#onStartAll"/>
</VBox>
